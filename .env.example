# Copy to .env and fill in. All variables are read in config/index.js.
# Commented lines show the default value: uncomment only to change it.

# --- Required ------------------------------------------------------------------
# Ignored by docker compose (it uses the bundled mongo, see COMPOSE_MONGODB_URI).
MONGODB_URI=mongodb://127.0.0.1:27017/brightminds
# Long random string: `openssl rand -hex 32`. Required in production.
JWT_SECRET=
# Public URL of this API, stored in media links. Required in production.
PUBLIC_BASE_URL=http://localhost:3000

# --- Secrets (features are disabled without them) ------------------------------
# AI processing of casts (see README "AI processing").
OPENAI_API_KEY=
# Gmail account + app password: verification, password reset and alert emails.
EMAIL_USER=
EMAIL_PWD=
# Receives alerts when OpenAI is unreachable, the key is rejected or an item gives up.
OPENAI_ALERT_EMAIL_TO=

# --- Server --------------------------------------------------------------------
# NODE_ENV=development
# PORT=3000
# REDIS_URL=redis://127.0.0.1:6379
# MEDIA_ROOT=backend/media
# WEBSITE_URL=https://greenlights.us

# --- Security ------------------------------------------------------------------
# "true" = reject unauthenticated writes. Enable once the app sends the Bearer token.
# AUTH_REQUIRED=false
# JWT_EXPIRES_IN=24h
# CORS_ORIGIN=*
# Number of reverse proxies in front of the API (1 behind Caddy/nginx).
# TRUST_PROXY=0

# --- AI models -----------------------------------------------------------------
# Quiz question, department and topic (structured outputs). No images are generated.
# OPENAI_CHAT_MODEL=gpt-6.1-terra
# none | low | medium | high: higher = better reasoning, slower and more expensive.
# OPENAI_REASONING_EFFORT=low
# whisper-1 is the only model with timestamps (subtitles); it shuts down 2027-02-26.
# OPENAI_TRANSCRIPTION_MODEL=whisper-1

# --- AI retries and alerts -----------------------------------------------------
# Daily re-run for content still missing AI outputs (cron syntax, server time).
# AI_RETRY_CRON=0 3 * * *
# Item-specific failures (e.g. moderation) before an item is marked "failed".
# AI_MAX_ATTEMPTS=5
# Minimum time between two identical alert emails (ms, default 1 hour).
# OPENAI_ALERT_THROTTLE_MS=3600000

# --- docker compose only -------------------------------------------------------
# Leave unset to use the bundled mongo container; set to use an external database.
# COMPOSE_MONGODB_URI=mongodb+srv://...
# API_BIND=127.0.0.1
# API_PORT=3000