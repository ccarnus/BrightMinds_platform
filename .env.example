# Copy to .env and fill in. All variables are read in config/index.js.

# --- Required -----------------------------------------------------------------
# Local dev: mongodb://127.0.0.1:27017/brightminds. Ignored by docker compose (see COMPOSE_MONGODB_URI).
MONGODB_URI=mongodb://127.0.0.1:27017/brightminds
# Long random string (e.g. `openssl rand -hex 32`). Required when NODE_ENV=production.
JWT_SECRET=
# Public URL of this API; stored in media links. Required when NODE_ENV=production.
PUBLIC_BASE_URL=http://localhost:3000

# --- Features -----------------------------------------------------------------
# Transcription, evaluations, images and topic detection.
OPENAI_API_KEY=
# Gmail app password of EMAIL_USER (verification + password reset emails).
EMAIL_USER=clement.carnus@brightmindsresearch.com
EMAIL_PWD=
# Bull job queues (cast/article background processing).
REDIS_URL=redis://127.0.0.1:6379

# --- Security -----------------------------------------------------------------
# "true" = reject unauthenticated writes. Enable once all clients send the Bearer token.
AUTH_REQUIRED=false
JWT_EXPIRES_IN=24h
CORS_ORIGIN=*
# Number of reverse proxies in front of the API (1 behind nginx/Caddy).
TRUST_PROXY=0

# --- Optional -----------------------------------------------------------------
NODE_ENV=development
PORT=3000
WEBSITE_URL=https://www.brightmindsresearch.com
# MEDIA_ROOT=/absolute/path/to/media   (default: backend/media)
# OPENAI_CHAT_MODEL=gpt-4
# OPENAI_IMAGE_MODEL=dall-e-3
# OPENAI_TRANSCRIPTION_MODEL=whisper-1
# OPENAI_ALERT_EMAIL_TO=you@example.com   (emailed when the OpenAI key is missing/rejected)

# --- docker compose only ------------------------------------------------------
# Leave unset to use the bundled mongo container; set to use e.g. MongoDB Atlas.
# COMPOSE_MONGODB_URI=mongodb+srv://...
# API_BIND=127.0.0.1
# API_PORT=3000
